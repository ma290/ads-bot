# Telegram API Credentials (from https://my.telegram.org)
API_ID=1234567
API_HASH=abcdef0123456789abcdef0123456789

# Telegram Bot Token (from @BotFather) — main Ads Bot
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRstuVWXyz
BOT_USERNAME=YourAdsBot

# Separate Logger Bot token (create another bot via @BotFather)
# Shows live ad stats: success / failed / flood wait / cycle progress
LOGGER_BOT_TOKEN=1234567890:XYZloggerBotTokenHere
LOGGER_BOT_USERNAME=YourLoggerBot

# Your Telegram numeric user ID(s) — only these can grant/revoke premium
# Get ID from @userinfobot
ADMIN_USER_IDS=123456789

# Free vs Premium limits
FREE_MAX_ACCOUNTS=3
PREMIUM_MAX_ACCOUNTS=20
FREE_MAX_CYCLES=20
PREMIUM_MAX_CYCLES=100
# Auto-reply cap for free users (per ad run); premium = unlimited
FREE_MAX_AI_REPLIES=20

# 3 Channels required for Force Subscription (Usernames with @ or Public links)
FORCE_SUB_CHANNELS=@channel_one,@channel_two,@channel_three

# Pacing & Engine Settings (in seconds)
MIN_DELAY=15
MAX_DELAY=40
MAX_RETRIES=3

# PostgreSQL Connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# When using docker-compose, use the service name as host (e.g. postgres)
DATABASE_URL=postgresql://campaign_user:campaign_pass@postgres:5432/campaign_db
